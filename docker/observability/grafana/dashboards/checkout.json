{
  "uid": "sre-checkout-demo",
  "title": "SRE Agent \u2014 Synthetic Checkout Metrics",
  "schemaVersion": 39,
  "version": 1,
  "description": "Local lab. Metrics are synthetic; Grafana and Prometheus queries are real.",
  "tags": [
    "sre-agent",
    "synthetic-demo"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"checkout-demo\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sre_demo_requests_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Error rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(sre_demo_requests_total{status=\"500\"}[1m])) / sum(rate(sre_demo_requests_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Synthetic p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sre_demo_latency_seconds{quantile=\"0.95\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
