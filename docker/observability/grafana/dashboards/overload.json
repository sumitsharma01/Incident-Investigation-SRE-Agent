{
  "uid": "sre-overload-proof",
  "title": "Checkout Overload \u2014 Baseline, Incident and Recovery",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "synthetic-demo",
    "proof-of-work"
  ],
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Checkout overload \u00b7 proof of work",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic incident, real telemetry pipeline.** Baseline 200 req/s \u2192 overload 2,000 req/s, P95 2.4 s, errors 20%, queue 850 \u2192 modeled recovery at the same incoming volume. Read-only agent; recovery is part of the generator, not an executed fix."
      }
    },
    {
      "id": 2,
      "title": "Incoming traffic",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sre_demo_requests_total{job=\"checkout-demo\"}[30s]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "P95 latency",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sre_demo_latency_seconds{job=\"checkout-demo\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
