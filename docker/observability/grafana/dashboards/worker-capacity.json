{
  "uid": "worker-capacity-proof",
  "title": "Worker capacity \u00b7 actual HTTP load",
  "schemaVersion": 39,
  "tags": [
    "sre-agent",
    "v0.4.0",
    "local-proof"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Traffic \u00b7 offered load held at 50 RPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sre_lab_requests_total{service=\"checkout-lab\"}[30s]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "P95 latency \u00b7 real HTTP requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sre_lab_latency_seconds{service=\"checkout-lab\",quantile=\"0.95\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Error ratio \u00b7 queue timeouts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sre_lab_requests_total{service=\"checkout-lab\",status=\"500\"}[30s])) / sum(rate(sre_lab_requests_total{service=\"checkout-lab\"}[30s]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Waiting requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sre-demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sre_lab_queue_depth{service=\"checkout-lab\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ],
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "refresh": ""
}
